  {"id":"tab1","type":"tab","label":"ПР5 solar","disabled":false,"info":"MQTT -> JSON -> InfluxDB (гаряче) + пакети -> S3 (холодне)"},
  {"id":"broker","type":"mqtt-broker","name":"mosquitto","broker":"mosquitto","port":"1883","clientid":"","autoConnect":true,"usetls":false,"protocolVersion":"4","keepalive":"60","cleansession":true},
  {"id":"influxcfg","type":"influxdb","hostname":"influxdb","port":"8086","protocol":"http","database":"solar","name":"influx v2","usetls":false,"tls":"","influxdbVersion":"2.0","url":"http://influxdb:8086","timeout":"10","rejectUnauthorized":false},

  {"id":"mqttin","type":"mqtt in","z":"tab1","name":"телеметрія панелей","topic":"kpi/shumakov/solar/+/telemetry","qos":"0","datatype":"utf8","broker":"broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":150,"y":120,"wires":[["json"]]},
  {"id":"json","type":"json","z":"tab1","name":"парсинг JSON","property":"payload","action":"obj","pretty":false,"x":360,"y":120,"wires":[["toinflux","batch"]]},
  {"id":"toinflux","type":"function","z":"tab1","name":"у формат InfluxDB","func":"// [поля, теги]; time - з поля ts (мс), щоб історія з --backfill лягла на свій час\nconst p = msg.payload;\nconst fields = {irradiance: p.irradiance, temp: p.temp, power: p.power, pr: p.pr, status: p.status};\nif (p.ts) fields.time = p.ts;\nmsg.payload = [fields, {device: p.device || 'panel01'}];\nreturn msg;","outputs":1,"x":580,"y":80,"wires":[["influxout"]]},
  {"id":"influxout","type":"influxdb out","z":"tab1","influxdb":"influxcfg","name":"solar / telemetry","measurement":"telemetry","precision":"","retentionPolicy":"","database":"","precisionV18FluxV20":"ms","retentionPolicyV18Flux":"","org":"kpi","bucket":"solar","x":820,"y":80,"wires":[]},
  {"id":"tick","type":"inject","z":"tab1","name":"кожні 2 хв","props":[{"p":"topic","vt":"str"}],"repeat":"120","crontab":"","once":false,"onceDelay":0.1,"topic":"flush","x":370,"y":220,"wires":[["batch"]]},
  {"id":"batch","type":"function","z":"tab1","name":"збір пакета","func":"// Накопичуємо сирі повідомлення; по сигналу flush віддаємо пакет одним JSON\nlet buf = context.get('buf') || [];\nif (msg.topic !== 'flush') {\n    buf.push(msg.payload);\n    context.set('buf', buf);\n    return null;\n}\nif (!buf.length) return null;\ncontext.set('buf', []);\nconst stamp = new Date().toISOString().replace(/[:.]/g, '-');\nconst key = `panel01/${stamp}.json`;\nmsg.payload = JSON.stringify(buf);\nmsg.filename = `/data/archive/${stamp}.json`;               // локальна копія\nmsg.url = `http://seaweedfs:8333/solar-archive/${key}`;     // S3 PUT\nmsg.method = 'PUT';\nmsg.headers = {'Content-Type': 'application/json'};\nnode.status({text: `${buf.length} записів -> ${key}`});\nreturn msg;","outputs":1,"x":580,"y":180,"wires":[["file","s3put"]]},
  {"id":"file","type":"file","z":"tab1","name":"файл JSON","filename":"filename","filenameType":"msg","appendNewline":false,"createDir":true,"overwriteFile":"true","encoding":"utf8","x":800,"y":160,"wires":[[]]},
  {"id":"s3put","type":"http request","z":"tab1","name":"PUT у SeaweedFS S3","method":"use","ret":"txt","paytoqs":"ignore","url":"","tls":"","persist":false,"proxy":"","insecureHTTPParser":false,"authType":"","senderr":false,"headers":[],"x":820,"y":200,"wires":[["dbg"]]},
  {"id":"dbg","type":"debug","z":"tab1","name":"відповідь S3","active":true,"tosidebar":true,"console":false,"complete":"statusCode","targetType":"msg","statusVal":"","statusType":"auto","x":1040,"y":200,"wires":[]}
